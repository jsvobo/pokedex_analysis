pivot_longer(cols = c(mean_attack, mean_total_stats),
names_to = "stat", values_to = "value") %>%
mutate(stat = ifelse(stat == "mean_attack", "Mean Attack", "Mean Total Stats"))
p_rarity_summary <- ggplot(rarity_long, aes(x = rarity, y = value, fill = rarity)) +
geom_col(alpha = 0.8) +
geom_text(aes(label = round(value, 1)), vjust = -0.3, size = 3.5) +
facet_wrap(~ stat, scales = "free_y") +
labs(title = "Mean Attack and Total Stats by Rarity",
subtitle = "Comparing stat levels across rarity categories",
x = "Rarity", y = "Value") +
theme_minimal() +
theme(legend.position = "none",
axis.text.x = element_text(angle = 15, hjust = 1))
print(p_rarity_summary)
