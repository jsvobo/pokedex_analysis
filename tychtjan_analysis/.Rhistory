# Mean total stats across each generation
gen_stats_summary <- pokemon %>%
group_by(gen) %>%
summarise(
n = n(),
mean_attack = mean(attack),
mean_total_stats = mean(total_stats),
sd_total_stats = sd(total_stats),
median_total_stats = median(total_stats)
)
cat("--- Mean Total Stats by Generation ---\n")
print(gen_stats_summary)
